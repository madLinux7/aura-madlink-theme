{
    "slug": "aura",
    "name": "Aura",
    "preview_gradient": "sunset-lavender",
    "short": "au",
    "contract_version": 1,
    "version": "0.1.0",
    "madlink_version": ">=0.1.0 <0.2.0",
    "author": "madLinux7",
    "requires_alpine": false,
    "link_type": "link_button",
    "avatar_customizable": true,
    "avatar_breakpoint_class": "au-avatar-wrapper",
    "default_config": {
        "background": "gradient",
        "gradient": "sunset-lavender",
        "custom_gradient": null,
        "accent_color": "#ffdaa3",
        "accent_color_active": true,
        "avatar": {
            "border-radius": "10%",
            "breakpoints": [
                {
                    "x": 1000,
                    "max-width": 200,
                    "max-height": 200
