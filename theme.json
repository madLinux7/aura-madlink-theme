            "default_color": "#ffdaa3",
            "default_text_color": "#1a1a2e",
            "shadow_color": null
        },
        "font": {
            "head": {
                "family": "habibi",
                "weight": 700
            },
            "body": {
                "family": "habibi",
                "weight": 500
            }
        },
        "qr_code": "toggle"
    },
